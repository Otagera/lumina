{
	"include": [
		"app/**/*",
		"**/.server/**/*",
		"**/.client/**/*"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": [
			"node",
			"vite/client",
			"vitest/globals",
			"@testing-library/jest-dom"
		],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"~/*": ["./app/*"],
			"@lumina/ui/*": ["../../packages/ui/src/*"],
			"@/*": ["../../packages/ui/src/*"]
		},
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	},
	"exclude": ["../api", ".react-router", "app/entry.server.tsx", "app/root.tsx", "app/routes/+types"]
}
